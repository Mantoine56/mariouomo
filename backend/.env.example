# Environment
NODE_ENV=development  # Use 'production' for production
PORT=3001

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Database - Supabase
DATABASE_URL=postgresql://postgres:password@your-project.supabase.co:5432/postgres
DATABASE_SCHEMA=public

# Database Pool Configuration
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_ACQUIRE_TIMEOUT=60000
DB_POOL_REAP_INTERVAL=1000

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-key
SUPABASE_JWT_SECRET=your-jwt-secret

# JWT Configuration
JWT_SECRET=your-jwt-secret
JWT_EXPIRES_IN=1d

# Redis (for local development)
REDIS_URL=redis://localhost:6379

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=debug  # Use 'error' for production
LOG_MAX_FILES=7d
LOG_MAX_SIZE=20m

# HTTP Caching
CACHE_PRODUCTS_MAX_AGE=3600
CACHE_CATEGORIES_MAX_AGE=7200
CACHE_DEFAULT_MAX_AGE=0

# Monitoring - Set to false in production
DISABLE_NEW_RELIC=true
DISABLE_SENTRY=true
